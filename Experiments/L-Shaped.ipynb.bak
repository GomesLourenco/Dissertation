  {
   "cell_type": "code",
   "execution_count": 16,
   "id": "cdb4bf17-282e-492a-8eb5-18a9296532a4",
   "metadata": {},
   "outputs": [],
   "source": [
    "import firedrake as fd\n",
    "from petsc4py import PETSc\n",
    "from slepc4py import SLEPc\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import scipy.linalg as la\n",
    "from scipy.interpolate import RegularGridInterpolator\n",
    "\n",
    "def plot_pseudospectrum(A_fd, B_fd, target, real_range, imag_range, res=50, interp_factor=4, nev=30):\n",
    "    \"\"\"\n",
    "    Computes and plots the pseudospectrum of the generalized eigenvalue problem Ax = lambda Bx.\n",
    "    Uses decoupled left/right solves and safely handles complex arithmetic via real-mode PETSc.\n",
    "    \"\"\"\n",
    "    \n",
    "    # 1. Assemble forms into matrices if necessary\n",
    "    if isinstance(A_fd, fd.Form):\n",
    "        print(\"Assembling A matrix...\")\n",
    "        A_fd = fd.assemble(A_fd)\n",
    "    if isinstance(B_fd, fd.Form):\n",
    "        print(\"Assembling B matrix...\")\n",
    "        B_fd = fd.assemble(B_fd)\n",
    "        \n",
    "    A = A_fd.petscmat\n",
    "    B = B_fd.petscmat\n",
    "    \n",
    "    # Create transposed matrices for the left eigenproblem\n",
    "    print(\"Creating transposed matrices for left solve...\")\n",
    "    A_t = A.transpose()\n",
    "    B_t = B.transpose()\n",
    "\n",
    "    def solve_eps(Op_A, Op_B, desc=\"right\"):\n",
    "        \"\"\"Helper to set up and solve a one-sided EPS problem.\"\"\"\n",
    "        eps = SLEPc.EPS().create()\n",
    "        eps.setOperators(Op_A, Op_B)\n",
    "        eps.setProblemType(SLEPc.EPS.ProblemType.GNHEP)\n",
    "        eps.setDimensions(nev=nev)\n",
    "        \n",
    "        # Setup Shift-and-Invert (SINVERT) with MUMPS\n",
    "        st = eps.getST()\n",
    "        st.setType(SLEPc.ST.Type.SINVERT)\n",
    "        st.setShift(target)\n",
    "        \n",
    "        ksp = st.getKSP()\n",
    "        ksp.setType('preonly')\n",
    "        pc = ksp.getPC()\n",
    "        pc.setType('lu')\n",
    "        pc.setFactorSolverType('mumps') \n",
    "        \n",
    "        print(f\"Solving {desc} eigenvalue problem...\")\n",
    "        eps.solve()\n",
    "        \n",
    "        nconv = eps.getConverged()\n",
    "        print(f\"Converged {desc} eigenpairs: {nconv}\")\n",
    "        if nconv == 0:\n",
    "            raise RuntimeError(f\"SLEPc failed to converge any {desc} eigenvalues.\")\n",
    "            \n",
    "        return eps, nconv\n",
    "\n",
    "    # 2. Solve Right Eigenproblem\n",
    "    eps_right, nconv_r = solve_eps(A, B, \"right\")\n",
    "    \n",
    "    # 3. Solve Left Eigenproblem (using transposed matrices)\n",
    "    eps_left, nconv_l = solve_eps(A_t, B_t, \"left\")\n",
    "    \n",
    "    # Use the minimum number of converged pairs to ensure matrices align\n",
    "    nconv = min(nconv_r, nconv_l)\n",
    "    \n",
    "    # 4. Extract the bases\n",
    "    N = A.getSize()[0]\n",
    "    V_mat = np.zeros((N, nconv), dtype=complex)\n",
    "    W_mat = np.zeros((N, nconv), dtype=complex)\n",
    "    \n",
    "    vr, vi = A.createVecs()\n",
    "    wr, wi = A_t.createVecs()\n",
    "    \n",
    "    eigenvalues = []\n",
    "    \n",
    "    for i in range(nconv):\n",
    "        # Right eigenvector\n",
    "        eigval = eps_right.getEigenpair(i, vr, vi)\n",
    "        eigenvalues.append(eigval)\n",
    "        V_mat[:, i] = vr.getArray() + 1j * vi.getArray()\n",
    "        \n",
    "        # Left eigenvector (from transposed solve)\n",
    "        eps_left.getEigenpair(i, wr, wi)\n",
    "        W_mat[:, i] = wr.getArray() + 1j * wi.getArray()\n",
    "        \n",
    "    eigenvalues = np.array(eigenvalues)\n",
    "    \n",
    "    # Orthonormalize the bases (QR decomposition) for stability\n",
    "    V, _ = np.linalg.qr(V_mat)\n",
    "    W, _ = np.linalg.qr(W_mat)\n",
    "    \n",
    "    # 5. Project matrices into the reduced space safely in real arithmetic\n",
    "    print(\"Projecting matrices into the reduced space...\")\n",
    "    def apply_mat(Mat, dense_V):\n",
    "        result = np.zeros_like(dense_V)\n",
    "        x, y = Mat.createVecs()\n",
    "        \n",
    "        for i in range(dense_V.shape[1]):\n",
    "            # 1. Apply matrix to the REAL part of the complex vector\n",
    "            x.setArray(dense_V[:, i].real)\n",
    "            Mat.mult(x, y)\n",
    "            real_part = y.getArray().copy()\n",
    "            \n",
    "            # 2. Apply matrix to the IMAGINARY part of the complex vector\n",
    "            x.setArray(dense_V[:, i].imag)\n",
    "            Mat.mult(x, y)\n",
    "            imag_part = y.getArray().copy()\n",
    "            \n",
    "            # 3. Recombine into a complex vector\n",
    "            result[:, i] = real_part + 1j * imag_part\n",
    "            \n",
    "        return result\n",
    "\n",
    "    AV = apply_mat(A, V)\n",
    "    BV = apply_mat(B, V)\n",
    "    \n",
    "    A_r = W.conj().T @ AV\n",
    "    B_r = W.conj().T @ BV\n",
    "    \n",
    "    # 6. Compute the minimum singular value over the coarse complex grid\n",
    "    print(f\"Evaluating resolvent over a {res}x{res} coarse grid...\")\n",
    "    x = np.linspace(real_range[0], real_range[1], res)\n",
    "    y = np.linspace(imag_range[0], imag_range[1], res)\n",
    "    X, Y = np.meshgrid(x, y)\n",
    "    \n",
    "    sigma_min = np.zeros((res, res))\n",
    "    \n",
    "    for i in range(res):\n",
    "        for j in range(res):\n",
    "            z = X[i, j] + 1j * Y[i, j]\n",
    "            M_z = z * B_r - A_r\n",
    "            s = la.svdvals(M_z)\n",
    "            sigma_min[i, j] = np.min(s)\n",
    "            \n",
    "    # 7. Upsample using Linear Interpolation for Smooth Contours\n",
    "    print(\"Interpolating grid for smooth contours...\")\n",
    "    interp_func = RegularGridInterpolator((y, x), sigma_min, method='linear')\n",
    "    \n",
    "    res_high = res * interp_factor\n",
    "    x_high = np.linspace(real_range[0], real_range[1], res_high)\n",
    "    y_high = np.linspace(imag_range[0], imag_range[1], res_high)\n",
    "    X_high, Y_high = np.meshgrid(x_high, y_high)\n",
    "    \n",
    "    pts = np.vstack([Y_high.ravel(), X_high.ravel()]).T\n",
    "    sigma_min_high = interp_func(pts).reshape(res_high, res_high)\n",
    "    \n",
    "    # 8. Plotting the Pseudospectrum\n",
    "    print(\"Plotting...\")\n",
    "    plt.figure(figsize=(10, 8))\n",
    "    \n",
    "    log_sigma = np.log10(sigma_min_high + 1e-16) \n",
    "    \n",
    "    levels = np.linspace(np.min(log_sigma), np.max(log_sigma), 15)\n",
    "    cp = plt.contourf(X_high, Y_high, log_sigma, levels=levels, cmap='viridis_r')\n",
    "    plt.colorbar(cp, label=r'$\\log_{10}(\\varepsilon)$')\n",
    "    \n",
    "    plt.contour(X_high, Y_high, log_sigma, levels=levels, colors='k', linewidths=0.5, alpha=0.5)\n",
    "    \n",
    "    plt.scatter(eigenvalues.real, eigenvalues.imag, c='red', marker='x', label='Eigenvalues')\n",
    "    \n",
    "    plt.title(f'Pseudospectrum (Reduced Space: {nconv}x{nconv})')\n",
    "    plt.xlabel('Real')\n",
    "    plt.ylabel('Imaginary')\n",
    "    plt.legend()\n",
    "    plt.grid(True, linestyle='--', alpha=0.6)\n",
    "    plt.xlim(real_range)\n",
    "    plt.ylim(imag_range)\n",
    "    plt.show()\n",
    "    \n",
    "    return eigenvalues, sigma_min"
   ]
  },
