   "source": [
    "N = 4\n",
    "L = np.pi\n",
    "num_refinements = 3\n",
    "base_mesh = get_unstructured_base_mesh(N, L)\n",
    "hierarchy = MeshHierarchy(base_mesh, num_refinements)\n",
    "    \n",
    "eigs, dofs, N_list = run_mesh_sweep(\n",
    "        mesh_hierarchy=hierarchy,\n",
    "        space_builder=make_nodal,\n",
    "        form_builder=B_formulation_2d1k,\n",
    "        bc_builder=bcs_nodal,\n",
    "        wind_func = wind_func_corner_singularity,\n",
    "        n_evals=30,\n",
    "        solver_opts=opts,\n",
    "        drop_harmonic=False,\n",
    "        degree=1,                                \n",
    "        eps=Constant(1.0)        \n",
    "    )\n",
    "\n",
    "print('FEEC-Conforming')\n",
    "table_eigenvalues(eigs, N_list, dofs)\n"
   ]
  },
