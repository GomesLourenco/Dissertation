   "source": [
    "N = 4\n",
    "L = np.pi\n",
    "num_refinements = 3\n",
    "\n",
    "mesh_topologies = [\"left\", \"right\", \"crossed\", \"unstructured\"]\n",
    "tables = {} # Dictionary to store our DataFrames\n",
    "\n",
    "# 1. Run the sweeps and collect the DataFrames\n",
    "for topo in mesh_topologies:\n",
    "    \n",
    "    if topo == \"unstructured\":\n",
    "        base_mesh = get_unstructured_base_mesh(N, L)\n",
    "    else:\n",
    "        base_mesh = SquareMesh(N, N, L, quadrilateral=False, diagonal=topo)\n",
    "        \n",
    "    hierarchy = MeshHierarchy(base_mesh, num_refinements)\n",
    "    \n",
    "    eigs, dofs, N_list = run_mesh_sweep(\n",
    "        mesh_hierarchy=hierarchy,\n",
    "        space_builder=FEEC_B_N1_2d1k,\n",
    "        form_builder=B_formulation_2d1k,\n",
    "        bc_builder=bcs_B_2d1k,\n",
    "        wind_func=wind_func,                  \n",
    "        n_evals=10,\n",
    "        solver_opts=opts,\n",
    "        drop_harmonic=False,\n",
    "        degree=1,                \n",
    "        eps=Constant(1.0)        \n",
    "    )\n",
    "    \n",
    "    # Store the pandas DataFrame\n",
    "    tables[topo] = table_eigenvalues(eigs, N_list, dofs)\n",
    "\n",
    "# 2. Render the 2x2 Grid using HTML\n",
    "html_str = f\"\"\"\n",
    "<table style=\"width:100%; border: none;\">\n",
    "  <tr>\n",
    "    <td style=\"vertical-align: top; border: none; padding: 10px;\">\n",
    "        <h3>Diagonal: Left</h3>\n",
    "        {tables['left'].to_html()}\n",
    "    </td>\n",
    "    <td style=\"vertical-align: top; border: none; padding: 10px;\">\n",
    "        <h3>Diagonal: Right</h3>\n",
    "        {tables['right'].to_html()}\n",
    "    </td>\n",
    "  </tr>\n",
    "  <tr>\n",
    "    <td style=\"vertical-align: top; border: none; padding: 10px;\">\n",
    "        <h3>Diagonal: Crossed</h3>\n",
    "        {tables['crossed'].to_html()}\n",
    "    </td>\n",
    "    <td style=\"vertical-align: top; border: none; padding: 10px;\">\n",
    "        <h3>Unstructured</h3>\n",
    "        {tables['unstructured'].to_html()}\n",
    "    </td>\n",
    "  </tr>\n",
    "</table>\n",
    "\"\"\"\n",
    "print('B-Formulation, N1 Elements')\n",
    "display(HTML(html_str))"
   ]
  },
