   "source": [
    "def make_nodal(mesh, degree):        # not a subcomplex -- the control case\n",
    "    return VectorFunctionSpace(mesh, \"CG\", degree) * FunctionSpace(mesh, \"CG\", degree)\n",
    "\n",
    "def bcs_nodal(W):\n",
    "    return [DirichletBC(W.sub(0).sub(1), 0, [1, 2]),\n",
    "            DirichletBC(W.sub(0).sub(0), 0, [3, 4]),\n",
    "            DirichletBC(W.sub(1), 0, \"on_boundary\")]\n",
    "\n",
    "\n",
    "eigs, dofs, N_list = run_mesh_sweep(\n",
    "        mesh_hierarchy=hierarchy,\n",
    "        space_builder=make_nodal,\n",
    "        form_builder=B_formulation_2d1k,\n",
    "        bc_builder=bcs_nodal,\n",
    "        wind_func = wind_func_corner_singularity,\n",
    "        n_evals=30,\n",
    "        solver_opts=opts,\n",
    "        drop_harmonic=False,\n",
    "        degree=1,                                \n",
    "        eps=Constant(1.0)        \n",
    "    )\n",
    "\n",
    "print('Not FEEC-Conforming')\n",
    "table_eigenvalues(eigs, N_list, dofs)\n"
   ]
  },
