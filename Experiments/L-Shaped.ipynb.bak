   "source": [
    "## Fixed Criss-Cross mesh, L shape xy_wind, satisfy all assumptions"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 51,
   "id": "a56e9e46-2252-466a-b50e-dba41eb52230",
