   "source": [
    "def wind_func_xy(mesh):\n",
    "    x,y = SpatialCoordinate(mesh)\n",
    "    return as_vector([x, -y]) \n",
    "\n",
    "setups = [\n",
    "    (\"FEEC_B_N1\", FEEC_B_N1_2d1k, B_formulation_2d1k, bcs_B_2d1k),\n",
    "    (\"FEEC_B_N2\", FEEC_B_N2_2d1k, B_formulation_2d1k, bcs_B_2d1k),\n",
    "    (\"FEEC_A\",    FEEC_A_2d1k,    A_formulation_2d1k, bcs_A_2d1k)\n",
    "]\n",
    "\n",
    "dataframes = []\n",
    "\n",
    "for name, space, form, bc in setups:\n",
    "    eigs, dofs, N_list, h_list = run_mesh_sweep(\n",
    "        mesh_hierarchy=hierarchy,\n",
    "        space_builder=space,\n",
    "        form_builder=form,\n",
    "        bc_builder=bc,\n",
    "        wind_func=wind_func_xy,\n",
    "        n_evals=100,\n",
    "        solver_opts=opts,\n",
    "        drop_harmonic=True,\n",
    "        degree=1,                                \n",
    "        eps=Constant(1000.0)        \n",
    "    )\n",
    "    \n",
    "    display(table_eigenvalues(eigs, N_list, dofs, h_list))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 115,
   "id": "4919f90c-0d5c-49e9-bf1d-de2b144385eb",
   "metadata": {},
   "outputs": [],
   "source": [
    "W = FEEC_B_N2_2d1k(mesh=hierarchy[-1], degree=1)\n",
    "a, m = B_formulation_2d1k(W, u=wind_func_xy(hierarchy[-1]), eps=Constant(100.0))\n",
    "bcs = bcs_B_2d1k(W)\n",
    "eigensolver = make_eigensolver(a, m, bcs, 32, opts)\n",
    "eig, eigf = solve_eigenpairs(eigensolver, drop_harmonic=False)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 117,
   "id": "50a66512-f0db-4cce-bf12-1ac5f40a044d",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1400x600 with 3 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "plot_eigenmode(eigensolver, 0, title_prefix=\"\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "8d75de1b-4e05-4f3f-ab9c-51b4fdfeec5d",
   "metadata": {},
   "source": [
    "## No Kings Theorem"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 118,
   "id": "393922f8-2410-4236-b5fa-02ffe2f984f4",
   "metadata": {},
   "outputs": [],
   "source": [
    "base_mesh =make_Lshape_mesh(n=4,diagonal ='crossed',structured=True)\n",
    "hierarchy = MeshHierarchy(base_mesh, refinement_levels=3)\n",
    "\n",
    "def wind_func_beltrami(mesh):\n",
    "    x, y = SpatialCoordinate(mesh)\n",
    "    \n",
    "    # Define the stream function psi = sin(2x)sin(2y)\n",
    "    psi = sin(2*x) * sin(2*y)\n",
    "    \n",
    "    # The velocity field is u = (∂y_psi, -∂x_psi)\n",
    "    # In UFL, .dx(1) is the derivative with respect to y, and .dx(0) is with respect to x\n",
    "    u_x = psi.dx(1)\n",
    "    u_y = -psi.dx(0)\n",
    "    \n",
    "    return as_vector([u_x, u_y])"
   ]
  },
